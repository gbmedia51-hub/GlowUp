# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ─── Supabase ────────────────────────────────────────────────
# Project: GlowUp (region: eu-west-3, id: ulrkpxjajwoxhfisjdip)
NEXT_PUBLIC_SUPABASE_URL="https://ulrkpxjajwoxhfisjdip.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key is NOT needed here.
# Supabase auto-injects SUPABASE_SERVICE_ROLE_KEY into Edge Functions
# at runtime; only add it locally if you need admin scripts outside
# the app runtime.

# ─── OpenAI ──────────────────────────────────────────────────
# Server-side only. Used exclusively inside Supabase Edge Functions.
OPENAI_API_KEY=""
OPENAI_MODEL_ASSESSMENT="gpt-4o"
OPENAI_MODEL_CHAT="gpt-4o-mini"

# ─── Payment provider: Fapshi ────────────────────────────────
PAYMENT_CURRENCY="XAF"
PAYMENT_AMOUNT="1999"
# Sandbox: https://sandbox.fapshi.com
# Live: https://live.fapshi.com
FAPSHI_BASE_URL="https://sandbox.fapshi.com"
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# Required in live mode. Also paste the same value in Fapshi dashboard
# → Live Webhook Secret. Any strong random string works, e.g. output of
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
FAPSHI_WEBHOOK_SECRET=""
# SUPABASE_SERVICE_ROLE_KEY is used server-side by the payment webhook
# so it can activate subscriptions without a user session.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Web Push (VAPID) ────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="gb.media51@gmail.com"
